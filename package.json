{
  "name": "codedbykay.artshow.mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server exposing the full CodedByKay.ArtShow.CLI workflow (catalog, R2 media, YouTube ids, classifiers, publish) to MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "artshow-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/test/"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
